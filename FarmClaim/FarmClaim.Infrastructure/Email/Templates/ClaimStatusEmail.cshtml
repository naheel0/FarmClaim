@using FarmClaim.Infrastructure.Email.Models
@model ClaimStatusChangedEmailModel
@{
    Layout = "_Layout.cshtml";
    var statusColor = Model.NewStatus switch
    {
        "Approved" => "#2e7d32",
        "Paid" => "#1565c0",
        "Rejected" => "#d32f2f",
        "UnderReview" => "#f57c00",
        _ => "#757575"
    };
}
@section Title { Claim Update — FarmClaim }

<h2 style="margin-top:0;">Claim Status Updated</h2>

<p>Hello @Model.FarmerName,</p>

<p>Your claim has been updated:</p>

<table style="width:100%;border-collapse:collapse;margin:20px 0;font-size:14px;">
    <tr>
        <td style="padding:10px;background-color:#f9f9f9;border:1px solid #eee;font-weight:600;">Claim ID</td>
        <td style="padding:10px;border:1px solid #eee;">#@Model.ClaimId.ToString().Substring(0, 8).ToUpper()</td>
    </tr>
    <tr>
        <td style="padding:10px;background-color:#f9f9f9;border:1px solid #eee;font-weight:600;">Incident Type</td>
        <td style="padding:10px;border:1px solid #eee;">@Model.IncidentType</td>
    </tr>
    <tr>
        <td style="padding:10px;background-color:#f9f9f9;border:1px solid #eee;font-weight:600;">New Status</td>
        <td style="padding:10px;border:1px solid #eee;">
            <span style="background-color:@statusColor;color:white;padding:4px 12px;
                         border-radius:12px;font-size:12px;font-weight:600;">
                @Model.NewStatus
            </span>
        </td>
    </tr>
</table>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <p style="background-color:#e3f2fd;padding:15px;border-radius:4px;border-left:4px solid #2196f3;">
        @Model.Message
    </p>
}

@if (Model.ApprovedAmount.HasValue)
{
    <p style="font-size:16px;color:#2e7d32;font-weight:600;">
        Approved Amount: ₹@Model.ApprovedAmount.Value.ToString("N2")
    </p>
}

<div style="text-align:center;margin:25px 0;">
    <a href="@Model.DashboardUrl" 
       style="background-color:#2e7d32;color:#ffffff;padding:12px 28px;
              text-decoration:none;border-radius:4px;display:inline-block;font-weight:600;">
        View Claim Details
    </a>
</div>