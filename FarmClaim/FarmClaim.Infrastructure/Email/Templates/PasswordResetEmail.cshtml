@using FarmClaim.Application.Common.Models.Email
@model PasswordResetEmailModel
@{
    Layout = "_Layout.cshtml";
    var resetLink = $"{Model.FrontendBaseUrl}/reset-password?email={Uri.EscapeDataString(Model.Email)}&token={Uri.EscapeDataString(Model.Token)}";
}
@section Title { Reset Your Password — FarmClaim }

<h2 style="color:#2e7d32;margin-top:0;">Reset Your Password</h2>

<p>Hello,</p>

<p>We received a request to reset the password for your FarmClaim account. Click the button below to set a new password:</p>

<div style="text-align:center;margin:30px 0;">
    <a href="@resetLink" 
       style="background-color:#2e7d32;color:#ffffff;padding:12px 28px;
              text-decoration:none;border-radius:4px;display:inline-block;font-weight:600;">
        Reset Password
    </a>
</div>

<p style="color:#666;font-size:13px;">
    <strong>This link expires in 30 minutes.</strong>
</p>

<p style="color:#666;font-size:13px;">
    If the button doesn't work, copy and paste this link into your browser:
</p>
<p style="background-color:#f4f4f4;padding:12px;border-radius:4px;font-size:12px;
          word-break:break-all;color:#2e7d32;">
    @resetLink
</p>

<hr style="border:none;border-top:1px solid #eee;margin:25px 0;">

<p style="color:#999;font-size:12px;">
    If you didn't request a password reset, you can safely ignore this email. 
    Your password will remain unchanged.
</p>