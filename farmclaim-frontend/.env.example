# ──────────────────────────────────────────────────────────────────────────────
# FarmClaim — Environment Variables
# Copy to .env.local and fill in real values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Backend (.NET API) ───────────────────────────────────────────────────────
# Override the default API base URL (https://localhost:7251).
NEXT_PUBLIC_API_BASE_URL=https://localhost:7251
#
# Required backend CORS config (Program.cs in your .NET API):
#   builder.Services.AddCors(o => o.AddPolicy("FarmClaim", p => p
#       .WithOrigins("http://localhost:3000")
#       .AllowAnyHeader()
#       .AllowAnyMethod()
#       .AllowCredentials()));
#   app.UseCors("FarmClaim");

# ── Razorpay (real card/UPI payments) ────────────────────────────────────────
# Public key ID — safe to expose in the browser. Get it from
# https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID

# The Razorpay Key SECRET must NEVER be in the frontend. It lives in your .NET
# API's appsettings.json (or user secrets):
#   "Razorpay": { "KeyId": "rzp_test_...", "KeySecret": "..." }
#
# Your .NET API must implement two endpoints used by src/lib/api.ts:
#   POST /api/v1/Payments/create-order/{policyId}
#   POST /api/v1/Payments/verify
